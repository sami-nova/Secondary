# Metabase Configuration
METABASE_URL=https://your-metabase-instance.com
METABASE_USERNAME=your-email@company.com
METABASE_PASSWORD=your-password

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Google Sheets Configuration
GOOGLE_SHEET_ID=your-google-sheet-id
SHEET_NAME=Deals
GOOGLE_CREDENTIALS_FILE=config/credentials.json
GOOGLE_TOKEN_FILE=config/token.pickle

# Google Slides Configuration
GOOGLE_PRESENTATION_ID=your-presentation-id

# Deal Notifier Configuration
DEAL_ID_FIELD=Deal ID
STATUS_FIELD=Status
CONTINUOUS_MODE=false
CHECK_INTERVAL=300

# Threshold Alerts Configuration
THRESHOLDS_CONFIG=config/thresholds.json
ALERT_STATE_FILE=config/alert_state.json

# Metabase Reports Configuration
REPORTS_CONFIG=config/metabase_reports.json

# Screenshot to Slides Configuration
DASHBOARDS_CONFIG=config/dashboards.json
SCREENSHOTS_DIR=temp/screenshots
